# Copy this file to config/api_keys.env and fill only the providers you use.
# config/api_keys.env is ignored by Git.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Optional local/custom provider settings
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Optional company-internal OpenAI-compatible gateway
INTERNAL_LLM_API_KEY=

# Optional published Dify Workflow app (use its app API key, not a console password)
DIFY_WORKFLOW_API_KEY=

# Adams additionally requires the caller RTX and a user token on every API request.
ADAMS_PLATFORM_USER=
ADAMS_USER_TOKEN=
