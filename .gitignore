# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
.venv/
venv/

# IDE / OS
.DS_Store
.idea/
.vscode/

# Secrets: keep the template, never commit real credentials.
.env
config/api_keys.env
config/*.local.env
config/*.internal.json
config/real_experiment.*.json

# Runtime outputs and local checkpoints
artifacts/
checkpoints/
tmp/

# Downloaded/generated datasets. Keep data/README.md tracked.
data/raw/
data/processed/
# Locally exported model outputs may be company-policy restricted. Keep the
# credential-free manifest/reports, but never commit the raw response matrix.
data/derived/**/*.zip
data/derived/**/items_with_responses.jsonl
